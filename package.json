    "react-dom": "18.2.0",
    "resend": "^6.12.2",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/node": "20.11.30",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "typescript": "5.4.5"
