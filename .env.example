# Copie para .env.local e preencha (nunca commitar .env.local)

# Supabase (obrigatório)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# E-mail (obrigatório para build — Resend instanciado em /api/email)
RESEND_API_KEY=
EMAIL_CONTATO=
EMAIL_ORCAMENTO=
EMAIL_ADMIN=

# WhatsApp — link público do site (apenas dígitos, DDI 55)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# WhatsApp Cloud API (servidor — não expor no client; ver docs/WHATSAPP-META-SANDBOX.md)
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Gestão Documental — Assinatura Avançada gov.br (Fase 4, somente servidor)
# GOVBR_SIGNATURE_CLIENT_ID=
# GOVBR_SIGNATURE_CLIENT_SECRET=
# GOVBR_SIGNATURE_REDIRECT_URI=https://www.ipecc.org.br/api/admin/documentos/assinaturas/callback
# GOVBR_SIGNATURE_ENV=staging
# GOVBR_SIGNATURE_SCOPE_EXTRA=
# GOVBR_SIGNATURE_CAS_URL=
# GOVBR_SIGNATURE_API_URL=
# WHATSAPP_VERIFY_TOKEN=ipecc_verify_staging_local
# WHATSAPP_APP_SECRET=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_BOT_ENABLED=1
# WHATSAPP_DRY_RUN=1
# WHATSAPP_PERSIST_SUPABASE=0
# WHATSAPP_LOG=1

# Leads do formulário público (wa.me) — requer docs/sql/whatsapp-leads-staging.sql
# WHATSAPP_LEADS_PERSIST_SUPABASE=0

# Migração proposta_anexos (staging — off por padrão em prod)
# USE_PROPOSTA_ANEXOS_TABLE=false
# NEXT_PUBLIC_USE_PROPOSTA_ANEXOS_TABLE=false
# USE_PROPOSTA_ANEXOS_ESCRITA=false
# NEXT_PUBLIC_USE_PROPOSTA_ANEXOS_ESCRITA=false
# USE_PROPOSTA_ANEXOS_SOMENTE_TABELA=false
# NEXT_PUBLIC_USE_PROPOSTA_ANEXOS_SOMENTE_TABELA=false
