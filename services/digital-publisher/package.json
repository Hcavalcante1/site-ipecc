  },
  "dependencies": {
    "@supabase/supabase-js": "2.90.1",
    "playwright": "^1.49.0"
  },
  "devDependencies": {
    "@types/node": "20.11.30",
    "tsx": "^4.19.0",
    "typescript": "5.4.5"
  }
}
