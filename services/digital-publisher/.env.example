# Supabase (obrigatório)
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Worker
DIGITAL_WORKER_ID=worker-local
DIGITAL_WORKER_POLL_INTERVAL_MS=15000
DIGITAL_MAX_PUBLISH_ATTEMPTS=4
DIGITAL_LOCK_TTL_MS=600000
PORT=8791

# true = simula publicação (padrão). false = Playwright real nas redes.
DIGITAL_PUBLISH_DRY_RUN=true

# Perfis persistentes do navegador (sessão por conta)
DIGITAL_BROWSER_STORAGE_DIR=.browser-profiles
DIGITAL_BROWSER_HEADLESS=true

# Tempo máximo aguardando login manual ao clicar Conectar (browser)
DIGITAL_CONNECT_TIMEOUT_MS=900000
