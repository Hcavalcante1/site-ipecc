# Copie para .env na mesma pasta (nunca versionar .env)
PORT=3001
POSTGRES_USER=documenso
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=documenso

# openssl rand -base64 32
NEXTAUTH_SECRET=
NEXT_PRIVATE_ENCRYPTION_KEY=
NEXT_PRIVATE_ENCRYPTION_SECONDARY_KEY=

# URL pública do Documenso (domínio ou túnel)
NEXT_PUBLIC_WEBAPP_URL=http://localhost:3001
NEXT_PRIVATE_INTERNAL_WEBAPP_URL=http://localhost:3000

# SMTP (obrigatório para e-mail aos signatários)
NEXT_PRIVATE_SMTP_TRANSPORT=smtp-auth
NEXT_PRIVATE_SMTP_HOST=
NEXT_PRIVATE_SMTP_PORT=587
NEXT_PRIVATE_SMTP_USERNAME=
NEXT_PRIVATE_SMTP_PASSWORD=
NEXT_PRIVATE_SMTP_FROM_NAME=IPECC Assinaturas
NEXT_PRIVATE_SMTP_FROM_ADDRESS=noreply@ipecc.org.br

# Ou Resend:
# NEXT_PRIVATE_SMTP_TRANSPORT=resend
# NEXT_PRIVATE_RESEND_API_KEY=
