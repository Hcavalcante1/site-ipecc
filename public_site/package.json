{
  "name": "apecc-site",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "node node_modules/typescript/lib/tsc.js --noEmit",
    "validar:enterprise": "npm run typecheck && npm run build",
    "audit:anexos": "node scripts/audit-anexos.mjs",
    "verify:proposta-anexos": "node scripts/verify-proposta-anexos.mjs",
    "smoke:health": "node scripts/check-health.mjs http://localhost:3050",
    "smoke:http": "node scripts/check-site.mjs --http http://localhost:3050",
    "smoke:static": "node scripts/check-site.mjs --dir ./out"
  },
  "dependencies": {
    "@supabase/ssr": "0.8.0",
    "@supabase/supabase-js": "2.90.1",
    "chart.js": "4.4.1",
    "firebase": "10.14.1",
    "jszip": "3.10.1",
    "next": "14.2.35",
    "react": "18.2.0",
    "react-chartjs-2": "5.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@types/node": "20.11.30",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "typescript": "5.4.5"
  }
}
